---
import BaseLayout from "../layouts/BaseLayout.astro";

const HERO_IMAGE = "/Gemini_Generated_Image_aw8b9saw8b9saw8b.png";
const localeFromPath = Astro.url.pathname.startsWith("/en") ? "en" : Astro.url.pathname.startsWith("/es") ? "es" : "fr";
const copyByLang = {
  fr: {
