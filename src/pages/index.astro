    description: "SaaS piscine pour mesures, interventions, Eco-Score MVP, Pool Passport et suivi propriétaire.",
    badge: "MVP SaaS piscine",
    navProduct: "Produit",
    dashboard: "Dashboard",
    testApp: "Tester l'app",
    headline: "Bluu3 — votre piscine, toujours sous contrôle.",
    intro: "Mesures d'eau, interventions, alertes, Eco-Score MVP et Pool Passport pour piscinistes, propriétaires et premiers pilotes.",
    demo: "Demander une démo",
    product: "Voir le produit",
    measurements: "Mesures",
    measurementsText: "pH, chlore, température, ORP.",
    interventions: "Interventions",
    interventionsText: "Planning, statuts, rapports.",
