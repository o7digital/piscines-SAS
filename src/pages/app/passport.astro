---
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppData } from "../../lib/db";
const data = await getAppData();
const poolId = Astro.url.searchParams.get("pool") ?? data.pools[0]?.id;
const pool = data.pools.find((item: any) => item.id === poolId);
const property = data.properties.find((item: any) => item.id === pool?.property_id);
const owner = data.users.find((item: any) => item.id === pool?.owner_id);
const provider = data.users.find((item: any) => item.id === pool?.provider_id);
const score = data.ecoScores.find((item: any) => item.pool_id === pool?.id);
const passport = data.poolPassports.find((item: any) => item.pool_id === pool?.id);
const checks = data.operationalChecks.filter((item: any) => item.pool_id === pool?.id).slice(0, 5);
---
<AppLayout title="Pool Passport" description="Pool Passport MVP Bluu3">
  <section class="space-y-6">
    <div><p class="text-xs uppercase tracking-[0.2em] text-white/45">Pool Passport MVP</p><h1 class="mt-2 text-3xl font-semibold">{pool?.name}</h1><p class="mt-3 text-white/70">Identité piscine, propriétaire, pisciniste, historique, Eco-Score et QR code placeholder.</p></div>
    {pool && <div class="grid gap-6 xl:grid-cols-[1fr_0.8fr]">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6"><h2 class="text-2xl font-semibold">Identité</h2><div class="mt-5 space-y-2 text-white/75"><p>Propriété : {property?.name}</p><p>Localisation : {pool.location}</p><p>Propriétaire : {owner?.name}</p><p>Pisciniste : {provider?.name}</p><p>Équipements : {passport?.equipment_summary}</p><p>QR code : {passport?.qr_code_url}</p></div><a class="mt-6 inline-flex rounded-2xl bg-emerald-400 px-4 py-3 text-sm font-semibold text-slate-950" href={`/api/exports/passport?pool=${pool.id}`}>Exporter PDF</a></article>
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6"><h2 class="text-2xl font-semibold">Eco-Score actuel</h2><div class="mt-4 text-5xl font-semibold">{score?.global_score}</div><p class="mt-2 text-white/60">Grade {score?.grade}</p><p class="mt-6 text-white/70">{passport?.history_summary}</p></article>
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 xl:col-span-2"><h2 class="text-2xl font-semibold">Checks opérationnels</h2><div class="mt-5 grid gap-3 md:grid-cols-2">{checks.map((item: any) => <div class="rounded-2xl border border-white/10 bg-slate-950/45 p-4"><div class="font-semibold">{new Date(item.checked_at).toLocaleDateString("fr-FR")} - {item.status}</div><p class="mt-2 text-sm text-white/65">{item.notes}</p></div>)}</div></article>
    </div>}
  </section>
</AppLayout>
