---
import AppLayout from "../../layouts/AppLayout.astro";
import ReportsDashboard from "../../components/app/ReportsDashboard";
import { hasDatabase } from "../../lib/db";
import { reportAIConfigured } from "../../lib/reportAI";
import { loadRequestedReport } from "../../lib/reportApi";
import { reportCopy } from "../../lib/reportCopy";
import { defaultReportMonth, getReportPools } from "../../lib/reportData";
import { automaticAnalysis, type ReportLanguage } from "../../lib/reporting";

const lang: ReportLanguage = Astro.url.pathname.startsWith("/en/") ? "en" : Astro.url.pathname.startsWith("/es/") ? "es" : "fr";
const selectedPool = Astro.url.searchParams.get("pool") || undefined;
const result = await loadRequestedReport({ month: Astro.url.searchParams.get("month") ?? defaultReportMonth(), pool: selectedPool, lang });
if (result.error) return result.error;
const pools = await getReportPools();
---
<AppLayout title={reportCopy[lang].title} description={reportCopy[lang].intro} lang={lang}>
  <ReportsDashboard report={result.report} lang={lang} selectedPool={selectedPool} pools={pools.map((pool) => ({ id: String(pool.id), name: String(pool.name) }))} demo={!hasDatabase()} aiEnabled={reportAIConfigured()} initialAnalysis={automaticAnalysis(result.report, lang)} client:load />
</AppLayout>
