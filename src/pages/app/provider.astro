---
import AppLayout from "../../layouts/AppLayout.astro";
import WinterMessages from "../../components/app/WinterMessages.jsx";

const pools = [
  ["B002", "M. Ferrari", "Ajaccio Centre", "45 m3", "6,8", "0,4 mg/L", "27,1°C", "52", "D", "pH + Chlore critiques", "critical"],
  ["B001", "Famille Bartoli", "Porticcio", "60 m3", "7,2", "0,8 mg/L", "26,4°C", "74", "B+", "Alerte chlore", "alert"],
  ["B005", "Mme Leonetti", "Sarrola-Carcopino", "50 m3", "7,5", "1,9 mg/L", "26,0°C", "83", "B", "Surveillance pH", "watch"],
  ["B003", "Villa Rossignol", "Bastelicaccia", "80 m3", "7,3", "2,1 mg/L", "25,8°C", "91", "A", "Tout va bien", "ok"],
  ["B004", "Résidence Moretti", "Prunelli", "35 m3", "7,1", "1,4 mg/L", "24,9°C", "88", "B+", "Tout va bien", "ok"],
  ["B006", "M. Acquaviva", "Ajaccio Sud", "70 m3", "7,2", "1,6 mg/L", "25,5°C", "86", "B+", "Tout va bien", "ok"],
];

const tour = [
  ["08h30", "B002 · M. Ferrari · Ajaccio Centre", "Urgent · 35 min · 8 min trajet", "critical"],
  ["09h30", "B001 · Famille Bartoli · Porticcio", "Chlore · 25 min · 22 min trajet", "alert"],
  ["11h00", "B005 · Mme Leonetti · Sarrola-Carcopino", "Surveillance · 20 min · 15 min trajet", "watch"],
  ["Après-midi", "B003, B004, B006", "Aucune visite requise cette semaine", "ok"],
];

const correctionSteps = [
  ["Maintenant", "pH 6,8", "Chlore 0,4", "Hors cible", "critical"],
  ["+ 10 min", "pH+ 300g", "Dissolution", "pH remonte", "watch"],
  ["+ 20 min", "Chlore choc 200g", "56% granulé", "Chlore remonte", "alert"],
  ["+ 35 min", "Algicide 100ml", "Stabilisation", "Zone saine", "ok"],
];

const statusStyles = {
  critical: {
    row: "border-red-500/80 bg-red-500/10",
    pill: "border-red-400/40 bg-red-500/20 text-red-100",
    label: "Rouge · Critique",
  },
  alert: {
    row: "border-red-500/70 bg-red-500/5",
    pill: "border-red-400/40 bg-red-500/20 text-red-100",
    label: "Rouge · Alerte",
  },
  watch: {
    row: "border-amber-400/80 bg-amber-400/10",
    pill: "border-amber-300/40 bg-amber-400/20 text-amber-100",
    label: "Orange · Surveillance",
  },
  ok: {
    row: "border-emerald-400/80 bg-emerald-400/10",
    pill: "border-emerald-300/40 bg-emerald-400/20 text-emerald-100",
    label: "Vert · Sain",
  },
};
---
<AppLayout title="Jean-Marc Marinelli" description="Cockpit pisciniste Bluu3">
  <section class="space-y-8">
    <div class="grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-7">
        <p class="text-xs uppercase tracking-[0.2em] text-emerald-300/80">C1 · Dashboard cockpit</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight">Jean-Marc Marinelli · Marinelli Piscines</h1>
        <p class="mt-3 text-white/70">Ajaccio · 6 bassins dans la démo, représentant un parc réel de 80 bassins · Lundi 19 mai 2026</p>
        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <div class="rounded-2xl border border-red-400/30 bg-red-400/10 p-4"><div class="text-3xl font-semibold text-red-200">2</div><div class="text-sm text-white/60">alertes critiques</div></div>
          <div class="rounded-2xl border border-amber-300/30 bg-amber-400/10 p-4"><div class="text-3xl font-semibold text-amber-100">1</div><div class="text-sm text-white/60">surveillance</div></div>
          <div class="rounded-2xl border border-emerald-400/30 bg-emerald-400/10 p-4"><div class="text-3xl font-semibold text-emerald-200">3</div><div class="text-sm text-white/60">bassins sains</div></div>
        </div>
        <div class="mt-5 flex flex-wrap gap-3 text-xs font-semibold">
          <span class="rounded-full border border-red-400/40 bg-red-500/20 px-3 py-2 text-red-100">Rouge · intervention prioritaire</span>
          <span class="rounded-full border border-amber-300/40 bg-amber-400/20 px-3 py-2 text-amber-100">Orange · surveillance</span>
          <span class="rounded-full border border-emerald-300/40 bg-emerald-400/20 px-3 py-2 text-emerald-100">Vert · bassin sain</span>
        </div>
      </article>

      <article class="rounded-3xl border border-white/10 bg-white/5 p-7">
        <p class="text-xs uppercase tracking-[0.2em] text-white/45">Actions démo</p>
        <div class="mt-4 grid gap-3">
          <a href="#tournee" class="rounded-2xl bg-emerald-400 px-4 py-3 text-sm font-semibold text-slate-950">Tournée du jour</a>
          <a href="#messages" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white">Générer messages</a>
          <a href="#consommables" class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-white">Prévisions consommables</a>
        </div>
      </article>
    </div>

    <article class="rounded-3xl border border-white/10 bg-white/5 p-6">
      <h2 class="text-2xl font-semibold">Liste du parc triée par urgence</h2>
      <div class="mt-5 overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead class="text-white/45">
            <tr><th class="py-3 pr-4">ID</th><th class="py-3 pr-4">Client</th><th class="py-3 pr-4">Adresse</th><th class="py-3 pr-4">pH</th><th class="py-3 pr-4">Chlore</th><th class="py-3 pr-4">Temp.</th><th class="py-3 pr-4">Score</th><th class="py-3 pr-4">Eco</th><th class="py-3 pr-4">Statut</th></tr>
          </thead>
          <tbody>
            {pools.map(([id, client, city, volume, ph, chlorine, temp, score, eco, status, level]) => (
              <tr class={`border-l-4 ${statusStyles[level].row} border-t border-white/10`}>
                <td class="py-4 pr-4 font-semibold text-white">{id}</td>
                <td class="py-4 pr-4">{client}<div class="text-xs text-white/45">{volume}</div></td>
                <td class="py-4 pr-4 text-white/65">{city}</td>
                <td class={`py-4 pr-4 font-semibold ${id === "B002" ? "text-amber-100" : id === "B005" ? "text-amber-100" : "text-emerald-100"}`}>{ph}</td>
                <td class={`py-4 pr-4 font-semibold ${id === "B002" || id === "B001" ? "text-red-100" : "text-emerald-100"}`}>{chlorine}</td>
                <td class="py-4 pr-4">{temp}</td>
                <td class="py-4 pr-4 font-semibold">{score}</td>
                <td class="py-4 pr-4">{eco}</td>
                <td class="py-4 pr-4">
                  <span class={`inline-flex rounded-full border px-3 py-1 text-xs font-semibold ${statusStyles[level].pill}`}>{statusStyles[level].label}</span>
                  <div class="mt-1 text-xs text-white/55">{status}</div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </article>

    <div class="grid gap-6 xl:grid-cols-2">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <p class="text-xs uppercase tracking-[0.2em] text-white/45">C2 · Diagnostic pré-intervention</p>
        <h2 class="mt-2 text-2xl font-semibold">B002 · M. Ferrari</h2>
        <p class="mt-2 text-white/65">45 m3 · Traitement chlore · Pompe Pentair 0,75 kW · Capteur Ondilo ICO · Dernière sync 09h14</p>
        <div class="mt-5 grid gap-3 sm:grid-cols-3">
          <div class="rounded-2xl bg-slate-950/45 p-4"><div class="text-sm text-white/50">pH</div><div class="text-3xl font-semibold text-amber-100">6,8</div><div class="text-xs text-white/45">Risque irritation + corrosion</div></div>
          <div class="rounded-2xl bg-slate-950/45 p-4"><div class="text-sm text-white/50">Chlore</div><div class="text-3xl font-semibold text-red-200">0,4</div><div class="text-xs text-white/45">Risque algues</div></div>
          <div class="rounded-2xl bg-slate-950/45 p-4"><div class="text-sm text-white/50">Temp.</div><div class="text-3xl font-semibold text-emerald-200">27,1°C</div><div class="text-xs text-white/45">OK</div></div>
        </div>
        <div class="mt-5 rounded-2xl border border-emerald-400/20 bg-emerald-400/10 p-4 text-white/80">
          Diagnostic Bluu3 AI : apporter 300g pH+, 200g chlore choc granulé 56%, 100ml algicide préventif. Durée estimée : 35 minutes. Priorité haute avant mercredi 21 mai.
        </div>
        <div class="mt-5 rounded-2xl border border-white/10 bg-slate-950/35 p-4">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <div class="text-sm font-semibold text-white">Courbe de rétablissement</div>
              <div class="mt-1 text-xs text-white/50">M. Ferrari · correction directe des dosages sur la trajectoire</div>
            </div>
            <span class="rounded-full border border-emerald-300/40 bg-emerald-400/15 px-3 py-1 text-xs font-semibold text-emerald-100">Objectif 35 min</span>
          </div>
          <div class="mt-4 overflow-x-auto">
            <div class="relative min-w-[620px] rounded-2xl bg-slate-950/45 p-4">
              <svg class="h-56 w-full" viewBox="0 0 680 230" role="img" aria-label="Courbe de correction pH et chlore pour M. Ferrari">
                <defs>
                  <linearGradient id="providerRecoveryFill" x1="0" x2="1" y1="0" y2="0">
                    <stop offset="0%" stop-color="#ef4444" stop-opacity="0.18" />
                    <stop offset="55%" stop-color="#f59e0b" stop-opacity="0.14" />
                    <stop offset="100%" stop-color="#34d399" stop-opacity="0.18" />
                  </linearGradient>
                  <filter id="providerGlow" x="-20%" y="-20%" width="140%" height="140%">
                    <feGaussianBlur stdDeviation="4" result="blur" />
                    <feMerge>
                      <feMergeNode in="blur" />
                      <feMergeNode in="SourceGraphic" />
                    </feMerge>
                  </filter>
                </defs>
                <rect x="72" y="34" width="512" height="116" rx="18" fill="#34d399" opacity="0.08" />
                <text x="590" y="76" fill="#a7f3d0" font-size="12" font-weight="700">Zone saine</text>
                <text x="590" y="96" fill="#94a3b8" font-size="11">pH 7,2 · chlore 1,6</text>
                <path d="M72 188 H620" stroke="#ffffff" stroke-opacity="0.14" />
                <path d="M72 150 H620" stroke="#ffffff" stroke-opacity="0.08" />
                <path d="M72 112 H620" stroke="#ffffff" stroke-opacity="0.08" />
                <path d="M72 74 H620" stroke="#ffffff" stroke-opacity="0.08" />
                <path d="M72 36 V188" stroke="#ffffff" stroke-opacity="0.14" />
                <path d="M78 170 C180 158 235 137 304 116 C384 92 470 78 586 64" fill="none" stroke="url(#providerRecoveryFill)" stroke-width="18" stroke-linecap="round" />
                <path d="M78 170 C180 158 235 137 304 116 C384 92 470 78 586 64" fill="none" stroke="#34d399" stroke-width="4" stroke-linecap="round" filter="url(#providerGlow)" />
                <path d="M78 178 C190 176 256 166 320 143 C404 112 482 92 586 82" fill="none" stroke="#fbbf24" stroke-width="3" stroke-dasharray="8 8" stroke-linecap="round" />
                <g fill="#020617" stroke-width="3">
                  <circle cx="78" cy="170" r="8" stroke="#f87171" />
                  <circle cx="246" cy="134" r="8" stroke="#fbbf24" />
                  <circle cx="410" cy="88" r="8" stroke="#f87171" />
                  <circle cx="586" cy="64" r="8" stroke="#34d399" />
                </g>
                <g fill="#94a3b8" font-size="11">
                  <text x="62" y="207">0</text>
                  <text x="230" y="207">10 min</text>
                  <text x="392" y="207">20 min</text>
                  <text x="566" y="207">35 min</text>
                </g>
                <g fill="#cbd5e1" font-size="11">
                  <text x="20" y="174">bas</text>
                  <text x="18" y="78">cible</text>
                </g>
              </svg>
              <div class="pointer-events-none absolute left-[84px] top-[142px] w-32 rounded-xl border border-red-400/40 bg-red-500/20 p-2 text-xs shadow-xl shadow-slate-950/30">
                <div class="font-semibold text-red-100">Départ critique</div>
                <div class="text-white/65">pH 6,8 · Cl 0,4</div>
              </div>
              <div class="pointer-events-none absolute left-[224px] top-[90px] w-36 rounded-xl border border-amber-300/40 bg-amber-400/20 p-2 text-xs shadow-xl shadow-slate-950/30">
                <div class="font-semibold text-amber-100">Ajouter pH+</div>
                <div class="text-white/65">300g directement</div>
              </div>
              <div class="pointer-events-none absolute left-[386px] top-[42px] w-40 rounded-xl border border-red-300/40 bg-red-500/20 p-2 text-xs shadow-xl shadow-slate-950/30">
                <div class="font-semibold text-red-100">Chlore choc</div>
                <div class="text-white/65">200g granulé 56%</div>
              </div>
              <div class="pointer-events-none absolute right-6 top-6 w-36 rounded-xl border border-emerald-300/40 bg-emerald-400/20 p-2 text-xs shadow-xl shadow-slate-950/30">
                <div class="font-semibold text-emerald-100">Rétabli</div>
                <div class="text-white/65">algicide 100ml</div>
              </div>
            </div>
          </div>
          <div class="mt-4 grid gap-2 sm:grid-cols-4">
            {correctionSteps.map(([time, title, note, result, level]) => (
              <div class={`rounded-2xl border p-3 text-xs ${statusStyles[level].row}`}>
                <div class="font-semibold text-white">{time}</div>
                <div class="mt-1 text-white/80">{title}</div>
                <div class="text-white/50">{note}</div>
                <div class="mt-2 font-semibold text-emerald-100">{result}</div>
              </div>
            ))}
          </div>
        </div>
      </article>

      <article id="tournee" class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <p class="text-xs uppercase tracking-[0.2em] text-white/45">C3 · Tournée optimisée</p>
        <h2 class="mt-2 text-2xl font-semibold">Lundi 19 mai 2026</h2>
        <div class="mt-5 space-y-3">
          {tour.map(([time, title, note, level]) => (
            <div class={`grid grid-cols-[72px_1fr] gap-3 rounded-2xl border p-4 ${statusStyles[level].row}`}>
              <div class="font-semibold text-emerald-200">{time}</div>
              <div>
                <span class={`inline-flex rounded-full border px-3 py-1 text-xs font-semibold ${statusStyles[level].pill}`}>{statusStyles[level].label}</span>
                <div class="mt-2 font-semibold">{title}</div>
                <div class="text-sm text-white/55">{note}</div>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-5 grid gap-3 text-sm text-white/75 sm:grid-cols-3">
          <div class="rounded-2xl bg-slate-950/45 p-4">2h30 vs 4h15</div>
          <div class="rounded-2xl bg-slate-950/45 p-4">48 km vs 72 km</div>
          <div class="rounded-2xl bg-slate-950/45 p-4">-4,2 kg CO2</div>
        </div>
      </article>
    </div>

    <article id="messages" class="rounded-3xl border border-white/10 bg-white/5 p-6">
      <p class="text-xs uppercase tracking-[0.2em] text-emerald-300/80">C4 · Fonction signature Bluu3 AI</p>
      <h2 class="mt-2 text-2xl font-semibold">Génération de messages en masse</h2>
      <p class="mt-2 text-white/65">Contexte : préparation hivernage octobre 2026. Montrer ce bouton en direct devant le comité CAPI.</p>
      <div class="mt-5">
        <WinterMessages client:load />
      </div>
    </article>

    <article id="consommables" class="rounded-3xl border border-white/10 bg-white/5 p-6">
      <p class="text-xs uppercase tracking-[0.2em] text-white/45">C5 · Prévision consommables</p>
      <h2 class="mt-2 text-2xl font-semibold">Besoins 4 semaines · 19 mai -> 19 juin 2026</h2>
      <div class="mt-5 grid gap-3 md:grid-cols-5">
        <div class="rounded-2xl bg-slate-950/45 p-4"><div class="text-sm text-white/50">Chlore 56%</div><div class="mt-2 text-2xl font-semibold">2,8 kg</div><div class="text-xs text-amber-100">+40% canicule</div></div>
        <div class="rounded-2xl bg-slate-950/45 p-4"><div class="text-sm text-white/50">pH+</div><div class="mt-2 text-2xl font-semibold">1,2 kg</div></div>
        <div class="rounded-2xl bg-slate-950/45 p-4"><div class="text-sm text-white/50">pH-</div><div class="mt-2 text-2xl font-semibold">0,4 kg</div></div>
        <div class="rounded-2xl bg-slate-950/45 p-4"><div class="text-sm text-white/50">Algicide</div><div class="mt-2 text-2xl font-semibold">600 ml</div></div>
        <div class="rounded-2xl bg-slate-950/45 p-4"><div class="text-sm text-white/50">Stabilisant</div><div class="mt-2 text-2xl font-semibold">0,8 kg</div></div>
      </div>
      <div class="mt-5 rounded-2xl border border-emerald-400/20 bg-emerald-400/10 p-4 text-white/80">Commander avant le 21 mai pour livraison avant la canicule. Economies estimées : -18% de gaspillage, -32 euros sur la commande mensuelle.</div>
    </article>
  </section>
</AppLayout>
