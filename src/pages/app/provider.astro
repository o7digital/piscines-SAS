    c1: "C1 · Panel operativo",
    heading: "Jean-Marc Marinelli · Piscinas Marinelli",
    intro: "Ajaccio · 6 piscinas en la demo, representando una cartera real de 80 piscinas · Lunes 19 de mayo de 2026",
    criticalAlerts: "alertas críticas",
    watch: "vigilancia",
    healthyPools: "piscinas sanas",
    redLegend: "Rojo · intervención prioritaria",
    orangeLegend: "Naranja · vigilancia",
    greenLegend: "Verde · piscina sana",
