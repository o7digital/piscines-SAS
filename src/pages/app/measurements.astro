---
import AppLayout from "../../layouts/AppLayout.astro";
import MeasurementsReview from "../../components/app/MeasurementsReview";
import { getAppData, hasDatabase } from "../../lib/db";
import { reportAIConfigured } from "../../lib/reportAI";
import { buildMonthlyReport } from "../../lib/reporting";
const data = await getAppData();
const months = [...new Set(data.measurements.map((item: any) => new Date(item.measured_at).toISOString().slice(0, 7)))];
const measurements = months.flatMap((month) => buildMonthlyReport(data, month).pools.flatMap((pool) => pool.measurements.map((item) => ({
  ...item, poolId: pool.poolId, poolName: pool.poolName, notes: String(data.measurements.find((row: any) => row.id === item.id)?.notes ?? ""),
})))).sort((a, b) => b.measuredAt.localeCompare(a.measuredAt));
---
<AppLayout title="Mesures & analyse IA" description="Mesures et recommandations Hugging Face pour chaque piscine">
  <MeasurementsReview measurements={measurements} pools={data.pools.map((pool: any) => ({ id: pool.id, name: pool.name }))} aiEnabled={reportAIConfigured()} demo={!hasDatabase()} client:load />
</AppLayout>
