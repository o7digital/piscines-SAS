---
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppData } from "../../lib/db";
const data = await getAppData();
---
<AppLayout title="Mesures" description="CRUD mesures Bluu3">
  <section class="space-y-6">
    <div><p class="text-xs uppercase tracking-[0.2em] text-white/45">CRUD</p><h1 class="mt-2 text-3xl font-semibold">Mesures piscine</h1><p class="mt-3 text-white/70">Saisie via API `POST /api/measurements`, historique alimenté par PostgreSQL ou seed local.</p></div>
    <div class="overflow-x-auto rounded-3xl border border-white/10 bg-white/5 p-4"><table class="min-w-full text-left text-sm"><thead class="text-white/45"><tr><th class="p-3">Piscine</th><th class="p-3">Date</th><th class="p-3">pH</th><th class="p-3">Chlore</th><th class="p-3">Temp.</th><th class="p-3">Notes</th></tr></thead><tbody>{data.measurements.map((item: any) => <tr class="border-t border-white/10"><td class="p-3">{data.pools.find((pool: any) => pool.id === item.pool_id)?.name}</td><td class="p-3">{new Date(item.measured_at).toLocaleString("fr-FR")}</td><td class="p-3">{item.ph}</td><td class="p-3">{item.chlorine}</td><td class="p-3">{item.temperature}</td><td class="p-3 text-white/65">{item.notes}</td></tr>)}</tbody></table></div>
  </section>
</AppLayout>
