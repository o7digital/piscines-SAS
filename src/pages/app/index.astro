---
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppData } from "../../lib/db";

const data = await getAppData();
const latestMeasurements = data.measurements.slice(0, 6);
const latestChecks = data.operationalChecks.slice(0, 4);
const criticalPools = data.pools.filter((pool: any) => pool.status !== "ok");
const today = new Date().toISOString().slice(0, 10);
const todayInterventions = data.interventions.filter((item: any) => String(item.scheduled_at).slice(0, 10) === today);
---
<AppLayout title="Vue globale" description="Dashboard Bluu3 MVP">
  <section class="space-y-6">
    <div class="max-w-3xl">
      <p class="text-xs uppercase tracking-[0.2em] text-white/45">MVP v1</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-white md:text-4xl">Vue globale Bluu3</h1>
      <p class="mt-3 text-white/70">Données réelles via PostgreSQL Railway quand `DATABASE_URL` est configuré, fallback seed pour tester immédiatement.</p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6"><div class="text-sm text-white/60">Propriétés</div><div class="mt-3 text-3xl font-semibold">{data.properties.length}</div></article>
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6"><div class="text-sm text-white/60">Alertes actives</div><div class="mt-3 text-3xl font-semibold">{criticalPools.length}</div></article>
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6"><div class="text-sm text-white/60">Interventions du jour</div><div class="mt-3 text-3xl font-semibold">{todayInterventions.length}</div></article>
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6"><div class="text-sm text-white/60">Utilisateurs</div><div class="mt-3 text-3xl font-semibold">{data.users.length}</div></article>
    </div>

    <div class="grid gap-6 xl:grid-cols-3">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <h2 class="text-2xl font-semibold">Dernières mesures</h2>
        <div class="mt-5 space-y-3">
          {latestMeasurements.map((item: any) => {
            const pool = data.pools.find((pool: any) => pool.id === item.pool_id);
            return <div class="rounded-2xl border border-white/10 bg-slate-950/45 p-4 text-sm text-white/75">
              <div class="font-semibold text-white">{pool?.name}</div>
              <div class="mt-1">pH {item.ph} / chlore {item.chlorine} / {item.temperature} C</div>
            </div>;
          })}
        </div>
      </article>
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <h2 class="text-2xl font-semibold">Derniers checks</h2>
        <div class="mt-5 space-y-3">
          {latestChecks.map((item: any) => {
            const pool = data.pools.find((pool: any) => pool.id === item.pool_id);
            return <div class="rounded-2xl border border-white/10 bg-slate-950/45 p-4 text-sm text-white/75">
              <div class="font-semibold text-white">{pool?.name}</div>
              <div class="mt-1">{item.status} - {item.notes}</div>
            </div>;
          })}
        </div>
      </article>
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <h2 class="text-2xl font-semibold">Piscines critiques</h2>
        <div class="mt-5 space-y-3">
          {criticalPools.map((pool: any) => <a href={`/app/passport?pool=${pool.id}`} class="block rounded-2xl border border-white/10 bg-slate-950/45 p-4 text-sm hover:bg-white/10">
            <div class="font-semibold text-white">{pool.name}</div>
            <div class="mt-1 text-white/65">{pool.location} - statut {pool.status}</div>
          </a>)}
        </div>
      </article>
    </div>
  </section>
</AppLayout>
