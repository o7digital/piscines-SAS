---
import AppLayout from "../../layouts/AppLayout.astro";
import { getAppData } from "../../lib/db";

const data = await getAppData();
const criticalPools = data.pools.filter((pool: any) => pool.status !== "ok");
---
<AppLayout title="Prototype CAPI" description="Démo Bluu3 navigable">
  <section class="space-y-8">
    <div class="grid gap-6 xl:grid-cols-[1.1fr_0.9fr]">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-7">
        <p class="text-xs uppercase tracking-[0.2em] text-emerald-300/80">Prototype démo en ligne · Mai 2026</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-white md:text-5xl">Bluu3 simule l'expérience complète avant financement.</h1>
        <p class="mt-4 max-w-3xl text-white/70">Démo statique enrichie avec données fictives : propriétaire, pisciniste, alertes, Eco-Score, Pool Passport, tournée optimisée et génération de messages.</p>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <a href="/app/owner" class="rounded-2xl bg-emerald-400 px-5 py-4 text-sm font-semibold text-slate-950 hover:bg-emerald-300">Je suis propriétaire</a>
          <a href="/app/provider" class="rounded-2xl border border-white/10 bg-white/5 px-5 py-4 text-sm font-semibold text-white hover:bg-white/10">Je suis pisciniste</a>
        </div>
      </article>

      <article class="rounded-3xl border border-white/10 bg-white/5 p-7">
        <div class="flex items-center gap-3">
          <div class="h-12 w-12 rounded-2xl bg-emerald-400"></div>
          <div>
            <div class="text-2xl font-semibold text-white">Bluu3</div>
            <div class="text-sm text-white/55">Login de cours Railway conservé</div>
          </div>
        </div>
        <form class="mt-6 space-y-3">
          <label class="block text-sm text-white/60">Email démo</label>
          <input class="w-full rounded-2xl border border-white/10 bg-slate-950/45 px-4 py-3 text-sm text-white" value="sophie.bartoli@demo.bluu3.io" />
          <label class="block text-sm text-white/60">Mot de passe</label>
          <input class="w-full rounded-2xl border border-white/10 bg-slate-950/45 px-4 py-3 text-sm text-white" type="password" value="demo-railway" />
          <a href="/app/owner" class="inline-flex w-full justify-center rounded-2xl bg-emerald-400 px-4 py-3 text-sm font-semibold text-slate-950">Entrer dans la démo</a>
        </form>
      </article>
    </div>

    <div class="grid gap-4 md:grid-cols-4">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-5"><div class="text-sm text-white/60">Écrans cahier des charges</div><div class="mt-2 text-3xl font-semibold">12</div></article>
      <article class="rounded-3xl border border-white/10 bg-white/5 p-5"><div class="text-sm text-white/60">Bassins démo</div><div class="mt-2 text-3xl font-semibold">6</div></article>
      <article class="rounded-3xl border border-white/10 bg-white/5 p-5"><div class="text-sm text-white/60">Alertes actives</div><div class="mt-2 text-3xl font-semibold">{criticalPools.length}</div></article>
      <article class="rounded-3xl border border-white/10 bg-white/5 p-5"><div class="text-sm text-white/60">Backend</div><div class="mt-2 text-xl font-semibold">Railway ready</div></article>
    </div>
  </section>
</AppLayout>
