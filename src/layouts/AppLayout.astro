---
import BaseLayout from "./BaseLayout.astro";
import { getAppData } from "../lib/db";

const { title = "Dashboard", description = "Bluu3 operations workspace", lang = "fr" } = Astro.props;
const pathname = Astro.url.pathname;
const data = await getAppData();
const basePrefix = lang === "fr" ? "" : `/${lang}`;
const localePath = pathname.replace(/^\/(en|es)(?=\/|$)/, "") || "/app";
const localeOptions = [
  { code: "fr", label: "FR", href: `${localePath}` },
  { code: "en", label: "EN", href: `/en${localePath}` },
  { code: "es", label: "ES", href: `/es${localePath}` },
];
const copyByLang = {
  fr: {
    today: "Aujourd'hui",
    subtitle: "Mesures, interventions, Eco-Score MVP et Pool Passport.",
    newMeasure: "Nouvelle mesure",
    tagline: "Votre piscine, toujours sous contrôle.",
    allPools: "Toutes les piscines",
    mvp: "Mode MVP : PostgreSQL Railway via `DATABASE_URL`, avec données seed locales quand la base n'est pas configurée.",
    nav: ["Vue globale", "Pisciniste", "Propriétaire", "Piscines", "Mesures", "Interventions", "Rapports IA", "Pool Passport", "Eco-Score", "Admin"],
  },
  en: {
    today: "Today",
    subtitle: "Measurements, interventions, MVP Eco-Score and Pool Passport.",
    newMeasure: "New measurement",
    tagline: "Your pool, always under control.",
    allPools: "All pools",
    mvp: "MVP mode: Railway PostgreSQL via `DATABASE_URL`, with local seed data when the database is not configured.",
    nav: ["Overview", "Provider", "Owner", "Pools", "Measurements", "Interventions", "AI reports", "Pool Passport", "Eco-Score", "Admin"],
  },
  es: {
    today: "Hoy",
    subtitle: "Mediciones, intervenciones, Eco-Score MVP y Pool Passport.",
    newMeasure: "Nueva medición",
    tagline: "Tu piscina, siempre bajo control.",
    allPools: "Todas las piscinas",
    mvp: "Modo MVP: PostgreSQL Railway via `DATABASE_URL`, con datos locales de prueba cuando la base no esta configurada.",
    nav: ["Vista global", "Piscinero", "Propietario", "Piscinas", "Mediciones", "Intervenciones", "Informes IA", "Pool Passport", "Eco-Score", "Admin"],
  },
};
const copy = copyByLang[lang] ?? copyByLang.fr;

const navItems = ["/app", "/app/provider", "/app/owner", "/app/pools", "/app/measurements", "/app/interventions", "/app/reports", "/app/passport", "/app/eco-score", "/app/admin"].map((href, index) => ({
  href: `${basePrefix}${href}`,
  label: copy.nav[index],
}));

const isActive = (href: string) => (href === `${basePrefix}/app` ? pathname === href : pathname.startsWith(href));
---
<BaseLayout
  title={`${title} | Bluu3`}
  description={description}
  themeColor="#020617"
  lang={lang}
  bodyClass="overflow-x-hidden bg-slate-950 text-white antialiased"
>
  <div class="min-h-screen overflow-x-hidden lg:flex">
    <div id="app-backdrop" class="fixed inset-0 z-40 hidden bg-slate-950/85 lg:hidden"></div>

    <aside
      id="app-sidebar"
      class="fixed inset-y-0 left-0 z-50 flex w-80 -translate-x-full flex-col border-r border-white/10 bg-slate-950/95 px-5 py-6 transition-transform duration-200 ease-out lg:static lg:translate-x-0"
    >
      <div class="flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-2xl border border-white/15 bg-white/10"></div>
          <div>
            <div class="font-display text-2xl font-semibold tracking-tight">Bluu3</div>
            <div class="text-xs text-white/50">MVP v1 console</div>
          </div>
        </a>

        <button
          id="nav-close"
          type="button"
          class="rounded-xl border border-white/10 bg-white/5 p-2 text-white/70 hover:bg-white/10 lg:hidden"
          aria-label="Close navigation"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current" stroke-width="1.8">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>

      <div class="mt-8 rounded-3xl border border-white/10 bg-white/5 p-4">
        <div class="text-xs uppercase tracking-[0.22em] text-white/45">{copy.today}</div>
        <div class="mt-2 text-sm text-white/80">{copy.subtitle}</div>
        <a
          href={`${basePrefix}/app/measurements`}
          class="mt-4 inline-flex w-full items-center justify-center rounded-2xl bg-emerald-400 px-4 py-3 text-sm font-semibold text-slate-950 hover:bg-emerald-300"
        >
          {copy.newMeasure}
        </a>
      </div>

      <div class="mt-4 rounded-2xl border border-white/10 bg-white/5 p-3 lg:hidden">
        <label class="text-xs font-semibold tracking-[0.14em] text-white/60">LANG</label>
        <div class="mt-2 flex gap-2">
          {localeOptions.map((option) => (
            <a
              href={option.href}
              class:list={[
                "rounded-lg border px-3 py-2 text-xs font-semibold",
                option.code === lang
                  ? "border-emerald-300/60 bg-emerald-400/20 text-emerald-100"
                  : "border-white/10 bg-slate-950/50 text-white/75 hover:bg-white/10",
              ]}
            >
              {option.label}
            </a>
          ))}
        </div>
      </div>

      <nav class="mt-8 space-y-2">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "flex items-center justify-between rounded-2xl border px-4 py-3 text-sm transition",
              isActive(item.href)
                ? "border-emerald-400/40 bg-emerald-400/10 text-white"
                : "border-transparent bg-transparent text-white/70 hover:border-white/10 hover:bg-white/5 hover:text-white",
            ]}
          >
            <span>{item.label}</span>
            <span class="text-xs text-white/40">{item.href === "/app" ? "Home" : "Open"}</span>
          </a>
        ))}
      </nav>

      <div class="mt-auto rounded-3xl border border-white/10 bg-white/5 p-4 text-sm text-white/65">
        {copy.mvp}
      </div>
    </aside>

    <div class="flex min-h-screen min-w-0 flex-1 flex-col overflow-x-hidden lg:pl-0">
      <header class="sticky top-0 z-30 border-b border-white/10 bg-slate-950/85 backdrop-blur">
        <div class="flex flex-wrap items-center gap-3 px-4 py-4 sm:px-6 lg:px-8">
          <button
            id="nav-toggle"
            type="button"
            class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-white/80 hover:bg-white/10 lg:hidden"
            aria-label="Open navigation"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current" stroke-width="1.8">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>

          <div class="min-w-0 flex-1">
            <div class="text-xs uppercase tracking-[0.2em] text-white/45">Bluu3</div>
            <div class="truncate text-sm text-white/70">{copy.tagline}</div>
          </div>

          <div class="hidden items-center gap-2 rounded-xl border border-white/10 bg-white/5 p-1 sm:inline-flex">
            {localeOptions.map((option) => (
              <a
                href={option.href}
                class:list={[
                  "rounded-lg px-2 py-1 text-xs font-semibold",
                  option.code === lang
                    ? "bg-emerald-400 text-slate-950"
                    : "text-white/75 hover:bg-white/10 hover:text-white",
                ]}
              >
                {option.label}
              </a>
            ))}
          </div>

          <label class="w-full min-w-[220px] max-w-sm sm:w-auto">
            <span class="sr-only">Selected property</span>
            <select
              class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white outline-none transition focus:border-emerald-400/50"
            >
              <option value="all">{copy.allPools}</option>
              {data.pools.map((pool: any) => (
                <option value={pool.id}>{pool.name}</option>
              ))}
            </select>
          </label>

          <a
            href={`${basePrefix}/app/measurements`}
            class="inline-flex items-center justify-center rounded-2xl bg-emerald-400 px-4 py-3 text-sm font-semibold text-slate-950 hover:bg-emerald-300"
          >
            {copy.newMeasure}
          </a>
        </div>
      </header>

      <main class="min-w-0 flex-1 overflow-x-hidden px-4 py-6 sm:px-6 lg:px-8">
        <slot />
      </main>
    </div>
  </div>

  <script is:inline>
    const sidebar = document.querySelector("#app-sidebar");
    const backdrop = document.querySelector("#app-backdrop");
    const openButton = document.querySelector("#nav-toggle");
    const closeButton = document.querySelector("#nav-close");

    const openSidebar = () => {
      sidebar?.classList.remove("-translate-x-full");
      backdrop?.classList.remove("hidden");
      document.body.classList.add("overflow-hidden");
    };

    const closeSidebar = () => {
      sidebar?.classList.add("-translate-x-full");
      backdrop?.classList.add("hidden");
      document.body.classList.remove("overflow-hidden");
    };

    openButton?.addEventListener("click", openSidebar);
    closeButton?.addEventListener("click", closeSidebar);
    backdrop?.addEventListener("click", closeSidebar);

    for (const link of document.querySelectorAll("#app-sidebar a")) {
      link.addEventListener("click", closeSidebar);
    }
  </script>
</BaseLayout>
